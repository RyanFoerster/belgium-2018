{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src/**/*"],
  "exclude": ["dist", "legacy", "refs", "node_modules"],
  "compilerOptions": {
    // components, data and lib are strict TypeScript; the scroll engine in src/scripts is plain ES modules
    "allowJs": true,
    "checkJs": false
  }
}

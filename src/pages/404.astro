---
/* Served by Cloudflare for any address that is not the story (wrangler.jsonc: not_found_handling). Written with Tailwind utilities. */
import Base from '../layouts/Base.astro';
import Sticker from '../components/ui/Sticker.astro';
---
<Base title="Off the pitch — Belgium 2018" description="This page is not part of the story.">
  <main class="grid min-h-dvh place-items-center bg-sun px-6 py-16 text-ink">
    <div class="relative w-full max-w-3xl">
      <p class="mb-6 inline-block -rotate-2 border-2 border-ink bg-devil px-3 py-2 font-display text-xs font-extrabold tracking-wide text-paper uppercase shadow-[4px_4px_0_#080808]">Error 404 · Offside</p>
      <h1 class="font-display text-[clamp(4.5rem,22vw,15rem)] leading-[.8] font-black tracking-tighter uppercase [font-stretch:62%]">Off the pitch.</h1>
      <p class="mt-8 max-w-md font-serif text-xl leading-snug">This page is not in the box. The story starts on the front page, with a newspaper folded in four.</p>
      <a href="/" class="mt-10 inline-block border-2 border-ink bg-ink px-5 py-3 font-display text-sm font-extrabold tracking-wide text-paper uppercase shadow-[5px_6px_0_#E52B32] transition-transform duration-300 hover:-translate-y-1">Back to kick-off</a>
      <Sticker type="rnd" a="404" b="NO GOAL" class="k" style="position:absolute;right:0;top:-2rem;--iz:clamp(84px,14vw,150px);--rot:11deg" />
    </div>
  </main>
</Base>

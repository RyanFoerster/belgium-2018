---
/* 07 · The swap pile: two rows of stickers drifting past each other. */
import PlayerSticker from '../../ui/PlayerSticker.astro';
import Sticker from '../../ui/Sticker.astro';
import Rip from '../../ui/Rip.astro';
import Proof from '../../ui/Proof.astro';
---
<!-- the swap pile: two rows of stickers crossing in opposite directions -->
<section class="blk s-sheet bg-y paper">
  <Rip colour="var(--w)" />
  <p class="mono lab">The swap pile</p>
  <div class="d mega sheet-word" data-parx=".5" aria-hidden="true">Got, got, need.</div>
  <div class="sheet-row" data-parx=".8" aria-hidden="true"><Sticker type="oval" a="RED DEVILS" b="BELGIUM" /><Sticker type="jersey" a="10" /><Sticker type="pent" a="2018" b="WORLD CUP" class="k" /><Sticker type="stack" a="GOAL!" /><Sticker type="dia" a="ROSTOV" class="k" /><Sticker type="flag" a="BEL" /><Sticker type="pill" a="16 GOALS" b="7 MATCHES" class="k" /><Sticker type="box" a="KAZAN" /><Sticker type="rnd" a="94′" b="CHADLI" class="k" /><Sticker type="hex" a="GOT, GOT" b="NEED" /></div>
  <div class="sheet-row" data-parx="-.8" aria-hidden="true"><PlayerSticker photo="hazard" number="10" name="E. Hazard" style="--rot:-3deg" /><Sticker type="chk" class="k" /><PlayerSticker photo="kdb" number="7" name="De Bruyne" style="--rot:3deg" /><PlayerSticker photo="lukaku" number="9" name="R. Lukaku" style="--rot:-4deg" /><Sticker type="bars" /><PlayerSticker photo="courtois" number="1" name="Courtois" style="--rot:-3deg" /><PlayerSticker photo="chadli" number="22" name="Chadli" style="--rot:0deg" /><Sticker type="rnd" a="3" b="THIRD PLACE" /><PlayerSticker photo="fellaini" number="8" name="Fellaini" style="--rot:4deg" /><PlayerSticker photo="meunier" number="15" name="Meunier" style="--rot:2deg" /></div>
  <span class="scrawl on-k sheet-scr fx-scrawl" data-in aria-hidden="true">swaps?</span>
  <Proof sheet={19} of={21} name="Swaps" />
</section>

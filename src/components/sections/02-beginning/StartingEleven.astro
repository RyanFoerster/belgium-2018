---
/* 02 · The starting eleven, placed on the pitch (scripts/pitch.js). */
---
<!-- Signature 01 — The Starting XI -->
<section class="scene s-xi bg-r" data-scene data-poster="1" id="xi" style="--len:4.4">
  <div class="pin">
    <div class="xi-type">
      <p class="mono lab">The starting XI<br>v Panama · Sochi · 18.06.2018</p>
      <div class="d xi-num" id="xiNum" aria-hidden="true">1</div>
      <div class="d xi-name" id="xiName">Courtois</div>
      <div class="mono xi-role" id="xiRole">Goalkeeper · Chelsea</div>
      <ol class="mono xi-list" id="xiList"></ol>
    </div>
    <div class="d xi-shape" data-t=".8 .88" data-ease="back" aria-label="3-4-2-1">3–4–2–1</div>
    <div class="xi-stage"><i class="tape y xi-tp1"></i><i class="tape y xi-tp2"></i><svg class="pitch" id="xiPitch" role="img" aria-label="Belgium's starting eleven against Panama in a 3-4-2-1 formation"></svg></div>
  </div>
</section>

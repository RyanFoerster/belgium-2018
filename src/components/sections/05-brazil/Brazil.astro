---
/* 05 · Brazil — the chapter opens on Brazil's flag in cut paper, filling the screen piece by piece;
   it then shrinks into its corner of the pile and the photograph of the eleven is underneath. */
import Photo from '../../ui/Photo.astro';
import Ticket from '../../ui/Ticket.astro';
import Doodle from '../../ui/Doodle.astro';
import Marks from '../../ui/Marks.astro';
---
<!-- ═══════════ 05 — BRAZIL ═══════════ -->
<section class="scene s-bra bg-k" data-scene data-chapter="05|Brazil — The Night We Believed" data-poster=".92" style="--len:3.2">
  <div class="pin">
    <Photo name="brazilTeam" class="bra-ph" data-t=".36 .6" />
    <div class="bra-fl" data-t=".36 .58" data-ease="io" aria-hidden="true">
      <i class="bra-g" data-t="0 .13" data-ease="o" data-torn="trbl" data-torn-d="9"></i>
      <i class="bra-y" data-t=".08 .21" data-ease="back"></i>
      <i class="bra-b" data-t=".16 .27" data-ease="back"></i>
      <b class="d bra-band" data-t=".22 .34" data-ease="io"><span>Brazil</span></b>
    </div>
    <p class="mono lab bra-lab" data-t=".02 .08">05 — Brazil · Quarter-final</p>
    <p class="mono m-meta bra-meta" data-o=".3 .4">Quarter-final · 6 July 2018<br>Kazan Arena · Att. 42,873</p>
    <h2 class="bra-h" aria-label="The night we believed.">
      <span class="d sp" data-split data-t=".56 .7">The night</span>
      <span class="d sp" data-split data-t=".64 .78">we believed.</span>
    </h2>
    <svg class="scr c-y bra-s" data-t=".78 .9"><use href="#s-line"/></svg>
    <span class="hand c-y bra-hand" data-t=".8 .92">five-time champions</span>
    <Doodle name="star" class="bra-star" data-at=".76" />
    <Ticket match={58} class="bra-tk fx-slide" data-at=".6" style="--rot:8deg;--fx:60vw;--spin:26deg" />
    <Photo name="brazilAction" class="cutout bra-cut fx-slap" data-cutout data-at=".68" style="--op:50% 30%" />
    <Photo name="braFan" print class="bra-fan fx-slap" caption="Kazan. he brought his own." tape="t" data-at=".72" style="--rot:-5deg;--ar:3/2" />
  </div>
</section>

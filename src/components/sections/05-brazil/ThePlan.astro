---
/* 05 · The plan: Martínez tears up the team sheet. */
import Rip from '../../ui/Rip.astro';
import Title from '../../ui/Title.astro';
import TitleLine from '../../ui/TitleLine.astro';
import TitleNote from '../../ui/TitleNote.astro';
import Doodle from '../../ui/Doodle.astro';
import Marks from '../../ui/Marks.astro';
import PlayerSticker from '../../ui/PlayerSticker.astro';
import Sticker from '../../ui/Sticker.astro';
---
<section class="blk s-plan bg-y paper">
  <Rip />
  <p class="mono lab">The plan</p>
  <Title label="Martínez tears up the team sheet." as="h3" class="plan-ttl">
    <TitleLine fx="flip" tile={3} data-in>Martínez</TitleLine>
    <TitleLine fx="slice" data-in>tears up the</TitleLine>
    <TitleNote x="48%" data-in class="c-r">Kazan, 6.07</TitleNote>
    <TitleLine fx="rise" data-in>team sheet.</TitleLine>
  </Title>
  <div class="sheet-w" data-in>
    <div class="sheet" data-rip>
      <p class="mono sheet-h">Team sheet — as v Japan, 2.07<br>amended for Kazan, 6.07</p>
      <ol class="sheet-l">
        <li><i>1</i>Courtois</li>
        <li><i>2</i>Alderweireld</li>
        <li><i>4</i>Kompany</li>
        <li><i>5</i>Vertonghen</li>
        <li><i>15</i>Meunier</li>
        <li><i>6</i>Witsel</li>
        <li class="chg"><i>7</i>De Bruyne <span class="hand c-r">false nine</span></li>
        <li class="out"><i>11</i><s>Carrasco</s> <span class="hand c-r">22 Chadli</span></li>
        <li class="out"><i>14</i><s>Mertens</s> <span class="hand c-r">8 Fellaini</span></li>
        <li><i>10</i>E. Hazard (c)</li>
        <li class="chg"><i>9</i>R. Lukaku <span class="hand c-r">right wing</span></li>
      </ol>
    </div>
  </div>
  <div class="plan-cols">
    <p class="pr" data-in>Fellaini and Chadli, the two substitutes who turned Rostov, both start. De&nbsp;Bruyne leaves midfield and plays as the central forward. Lukaku — a number nine all his life — goes out to the right, into the space behind Marcelo.</p>
    <p class="pr" data-in style="--d:.15s">Thirteen minutes in, Chadli's corner, Kompany's flick, Fernandinho's arm: an own goal, and Belgium lead.</p>
  </div>
  <div class="plan-score" data-in>
    <!-- how the first goal came: the three touches of the paragraph above, as a route -->
    <div class="plan-og" aria-label="Chadli's corner, Kompany's flick, an own goal">
      <div class="plan-og-i"><PlayerSticker photo="chadli" number="22" name="Chadli" style="--rot:-4deg" /><span class="mono">the corner</span></div>
      <svg class="scr c-r"><use href="#s-arrow2"/></svg>
      <div class="plan-og-i"><PlayerSticker photo="kompany" number="4" name="Kompany" style="--rot:3deg" /><span class="mono">the flick</span></div>
      <svg class="scr c-r"><use href="#s-arrow2"/></svg>
      <div class="plan-og-i"><Sticker type="hex" a="OWN GOAL" b="13′" class="k" style="--rot:-6deg" /><span class="mono">Fernandinho's arm</span></div>
    </div>
    <span class="hand c-r plan-og-h">thirteen minutes in</span>
    <span class="d">1—0</span>
  </div>
  <svg class="scr c-r plan-ex" data-in style="--d:.4s"><use href="#s-excl"/></svg>
  <Marks kind="tactic" seed={9} class="plan-tac" data-in />
  <Doodle name="arrow" class="r plan-arr" data-in />
  <Marks kind="brush" seed={5} n={11} class="plan-brush" data-in />
</section>

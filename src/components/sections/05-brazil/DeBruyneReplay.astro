---
/* 05 · De Bruyne, 31′ — the second goal against Brazil replayed on the tactical board.
   Same board as Chadli's: a black slab, a list of steps you can click, and a goal set like an award. */
import Sticker from '../../ui/Sticker.astro';
import Doodle from '../../ui/Doodle.astro';
import GoalCard from '../../ui/GoalCard.astro';
---
<!-- Replay 2: De Bruyne 31' -->
<section class="scene s-replay s-replay-b bg-r" data-scene data-poster=".66" id="kdb" style="--len:4.2">
  <div class="pin">
    <p class="mono lab rp-lab">Kazan Arena · 31′ · 1—0<br>Reconstruction, simplified</p>
    <div class="rp-stage"><Sticker type="rnd" a="31′" b="KAZAN" class="y rp-c1" /><Sticker type="dots" class="rp-c2" /><svg class="pitch" id="kdbPitch" role="img" aria-label="Top-down reconstruction of Kevin De Bruyne's goal against Brazil"></svg></div>
    <ol class="rp-steps">
      <li data-step="1"><b class="d">01</b><h4 class="d">Out of the box</h4><p>A Brazil corner is cleared. Lukaku wins the ball deep in his own half and turns.</p></li>
      <li data-step="2"><b class="d">02</b><h4 class="d">Forty yards</h4><p>He just keeps running. Through the middle of Brazil's midfield, yellow shirts bouncing off him.</p></li>
      <li data-step="3"><b class="d">03</b><h4 class="d">The strike</h4><p>The pass goes right. De&nbsp;Bruyne takes it to the edge of the area and hits it low, across Alisson, inside the far post.</p></li>
    </ol>
    <div class="rp-final">
      <div class="rp-sheet"><div class="rp-sheet-in">
        <GoalCard photo="kdb" ink="rk" no={7} first="Kevin" last="De Bruyne" note="two—nil" title="The second" meta={'31′ · Kazan Arena · Brazil 0⁠—⁠2 Belgium'} facts={[['0—2', 'Brazil — Belgium'], ['1', 'goal in Russia']]} />
      </div></div>
      <Doodle name="ball" class="rp-roll" />
      <Sticker type="rnd" a="31′" b="KAZAN" class="rp-fs1" />
    </div>
  </div>
</section>

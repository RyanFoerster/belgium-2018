---
/* 04 · The 12th man — a strip of supporters sliding sideways. */
import Photo from '../../ui/Photo.astro';
import Sticker from '../../ui/Sticker.astro';
import Rip from '../../ui/Rip.astro';
import Proof from '../../ui/Proof.astro';
---
<!-- the stands: a line of prints that travels sideways as you scroll -->
<section class="blk s-strip bg-r paper">
  <Rip colour="var(--w)" />
  <p class="mono lab">In the stands — Moscow, Kaliningrad, and the night of 2 July</p>
  <div class="d mega strip-word" data-parx=".42" aria-hidden="true">Red everywhere</div>
  <svg class="scr strip-string" data-in preserveAspectRatio="none"><use href="#s-line"/></svg>
  <span class="scrawl on-k strip-scr fx-scrawl" data-in style="--d:.3s" aria-hidden="true">the 12th man</span>
  <div class="strip-row" data-parx="1">
    <Photo name="flag" print class="duo-y" caption="Moscow, 23.06" tape="t" style="--rot:-4deg;--ar:3/2" />
    <Photo name="fansOutside" print class="stack" caption="outside Spartak" pin style="--rot:5deg;--ar:3/2" />
    <Sticker type="oval" a="RED DEVILS" b="THE 12TH MAN" class="k" />
    <Photo name="fansKal" class="cutout" data-cutout style="--rot:-6deg;--op:50% 30%" />
    <Photo name="wall" print class="crease" caption="Kaliningrad, 28.06" tape="tl" style="--rot:3deg;--ar:3/2" />
    <Sticker type="flag" a="BEL" />
    <Photo name="benchKal" print class="duo-r" caption="the bench, same night" tape="t" style="--rot:-3deg;--ar:3/2" />
    <Photo name="street" print class="dog" caption="2.07.18" pin style="--rot:6deg;--ar:3/4;--op:50% 35%" />
  </div>
  <Proof sheet={9} of={21} name="The 12th Man" />
</section>

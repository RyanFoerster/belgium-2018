---
/* 04 · Chadli, 90+4′ — the counter-attack replayed pass by pass on the tactical board.
   The board is a black slab; its steps are a list you can click (scripts/nav.js). The goal itself is set like an award:
   a ball rolls across the screen and leaves the scorer's card behind it. */
import Photo from '../../ui/Photo.astro';
import Sticker from '../../ui/Sticker.astro';
import Doodle from '../../ui/Doodle.astro';
import Marks from '../../ui/Marks.astro';
import GoalCard from '../../ui/GoalCard.astro';
---
<!-- Signature 02 + 04 — The Impossible Comeback -->
<section class="scene s-replay bg-y paper" data-scene data-poster=".7" id="chadli" style="--len:6.4">
  <div class="pin">
    <p class="mono lab rp-lab">Rostov Arena · 90+4′ · 2—2<br>Reconstruction, simplified</p>
    <div class="rp-stage"><Sticker type="rnd" a="94′" b="ROSTOV" class="y rp-c1" /><Sticker type="dots" class="rp-c2" /><svg class="pitch" id="rpPitch" role="img" aria-label="Top-down reconstruction of Nacer Chadli's winning goal against Japan"></svg></div>
    <ol class="rp-steps">
      <li data-step="1"><b class="d">01</b><h4 class="d">The last corner</h4><p>Stoppage time. Honda swings Japan's corner in; Japan have thrown bodies forward for a winner. Courtois comes and catches.</p></li>
      <li data-step="2"><b class="d">02</b><h4 class="d">The release</h4><p>He is running before he lands. To the edge of his area — and the ball is rolled into De&nbsp;Bruyne's stride.</p></li>
      <li data-step="3"><b class="d">03</b><h4 class="d">The carry</h4><p>De&nbsp;Bruyne drives straight down the middle and across halfway. Japan can only back off.</p></li>
      <li data-step="4"><b class="d">04</b><h4 class="d">The decoy</h4><p>Lukaku cuts inside and takes his marker with him. The right flank opens. De&nbsp;Bruyne slides the ball into it for Meunier.</p></li>
      <li data-step="5"><b class="d">05</b><h4 class="d">The dummy</h4><p>Meunier crosses low, first time. Lukaku shapes to shoot — and steps over it. He never touches the ball.</p></li>
      <li data-step="6"><b class="d">06</b><h4 class="d">The finish</h4><p>Chadli has run the length of the pitch. At the far post, he cannot miss.</p></li>
    </ol>
    <div class="rp-final">
      <div class="rp-sheet"><div class="rp-sheet-in">
        <GoalCard photo="chadli" ink="yk" no={22} first="Nacer" last="Chadli" note="impossible" title="The winner" meta={'90+4′ · Rostov Arena · Belgium 3⁠—⁠2 Japan'} facts={[['3—2', 'from 0—2 down'], ['65′', 'came on as a substitute']]} />
      </div></div>
      <Doodle name="ball" class="rp-roll" />
      <Sticker type="rnd" a="94′" b="ROSTOV" class="y rp-fs1" />
    </div>
    <div class="rp-flood bg-y">
      <!-- full time: the sheet comes up and everything is thrown in the air -->
      <Marks kind="shards" seed={9} n={28} class="rp-fl-conf" data-at=".962" />
      <span class="d rp-32" aria-label="3-2">3—2</span>
      <p class="mono rp-flood-m">Belgium — Japan<br>Full time</p>
      <Photo name="street" print class="rp-flood-ph" caption="2.07.18 — that night" tape="t" style="--rot:-6deg;--ar:3/4;--op:50% 35%" />
      <Photo name="japan" print class="rp-flood-ph rp-flood-p2" caption="Rostov Arena" pin style="--rot:5deg;--ar:3/2" />
      <Sticker type="pill" a="QUARTER-FINAL" b="BRAZIL NEXT" class="k fx-stamp rp-fl-s1" data-at=".972" style="--rot:-6deg" />
      <Sticker type="rnd" a="0—2" b="TO 3—2" class="fx-stamp rp-fl-s2" data-at=".978" style="--rot:9deg" />
      <Doodle name="megaphone" class="r rp-fl-d1" data-at=".968" />
      <Doodle name="star" class="rp-fl-d2" data-at=".974" />
      <Doodle name="flame" class="r rp-fl-d3" data-at=".98" />
      <span class="hand rp-flood-h">around ten seconds, box to box</span>
    </div>
  </div>
</section>

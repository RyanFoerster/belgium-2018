---
/* A word that is an event: the display face, every letter with its own tilt.
   With data-t the letters fly in with the scroll, each from its own side; with data-in / data-at they land once.
   `ghost` repeats the word behind itself, offset — a second and third pass of the same screen. */
import { rng } from '../../lib/rng';
import { pass } from '../../lib/attrs';

interface Props {
  text: string;
  seed?: number;
  ghost?: number;
  class?: string;
  style?: string;
  [attr: string]: unknown;
}
const { text, seed = 1, ghost = 0, class: cls, style = '', ...rest } = Astro.props;
const q = rng(seed * 331 + 7);
const chars = Array.from(text);
// one face, one size: only the tilt and the baseline change from letter to letter
const letters = chars.map((c, i) => ({
  c,
  style: `--i:${i};--rz:${((q() - .5) * 7).toFixed(1)}deg;--dy:${((q() - .5) * .1).toFixed(3)}em;--fx:${Math.round((q() - .5) * 150)}vw;--fy:${Math.round((q() - .5) * 130)}vh;--spin:${Math.round((q() - .5) * 150)}deg`,
}));
---
<div class:list={['shout', cls]} role="img" aria-label={text} style={`--n:${chars.length};${style}`} {...pass(rest)}>
  {Array.from({ length: ghost }, (_, g) => <span class="sh-g" aria-hidden="true" style={`--g:${g + 1}`}>{text}</span>)}
  <span class="sh-w" aria-hidden="true">{letters.map((l) => l.c === ' ' ? <span class="sh-sp"> </span> : <span class="sh-l" style={l.style}>{l.c}</span>)}</span>
</div>

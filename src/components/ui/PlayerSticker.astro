---
/* An album sticker: a portrait, and — when given — the shirt number and the name printed under it.
   Without a photograph it is the album's empty frame: the number alone on a flat colour. */
import type { PhotoKey } from '../../data/photos';
import { pass } from '../../lib/attrs';

interface Props {
  photo?: PhotoKey;
  number?: number | string;
  name?: string;
  /** where the portrait is centred in its frame (object-position) */
  focus?: string;
  class?: string;
  [attr: string]: unknown;
}
const { photo, number, name, focus, class: cls, ...rest } = Astro.props;
---
<div class:list={['stk', !photo && 'stk-none', cls]} {...pass(rest)}>{photo
  ? <figure class="ph" data-photo={photo} style={focus ? `--op:${focus}` : undefined}></figure>
  : <div class="stk-blank" aria-hidden="true"><b class="d">{number}</b></div>}{number != null && <b class="d stk-n">{number}</b>}{name && <span class="d stk-nm">{name}</span>}</div>

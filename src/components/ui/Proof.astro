---
/* The marks of a printer's proof around a sheet: crop marks in the corners, registration targets top and bottom,
   and along the right edge the sheet number with the three inks. Purely decorative; takes the ink colour of its section. */
interface Props {
  /** number of this sheet, and how many there are */
  sheet: number;
  of: number;
  name: string;
}
const { sheet, of: total, name } = Astro.props;
const two = (n: number) => String(n).padStart(2, '0');
---
<div class="proof" aria-hidden="true"><i class="pm c1"></i><i class="pm c2"></i><i class="pm c3"></i><i class="pm c4"></i><i class="rg t"></i><i class="rg b"></i><span class="proof-cap"><span class="proof-bar"><b></b><b></b><b></b></span>BEL—18 · Sheet {two(sheet)}/{two(total)} · {name}</span></div>

---
/* What stays on screen: the running head, the progress bar, the ticket stubs collected so far, the chapter badge —
   and the way round the page: a chapter index that drops over everything, and a rail of chapters down the right edge.
   The index, the rail and what the stubs do when clicked are filled in by scripts/nav.js from the page's own [data-chapter] sections. */
import Sticker from '../ui/Sticker.astro';
---
<header class="hud" aria-hidden="true">
  <span class="hud-l">BEL—18</span>
  <span class="hud-c"><b id="hudNo">01</b>/08 — <i id="hudName">The Dream</i></span>
  <span class="hud-r">Russia · 14.06—15.07.2018</span>
</header>
<button type="button" class="hud-menu" id="navBtn" aria-controls="nav" aria-expanded="false"><i aria-hidden="true"></i><span>Chapters</span></button>
<nav class="nav" id="nav" aria-label="Chapters" data-lenis-prevent inert>
  <div class="nav-in">
    <p class="mono nav-top"><span>BEL—18 · The Road to Glory</span><span>Eight chapters · seven matches</span></p>
    <ol class="nav-list" id="navList"></ol>
    <div class="nav-more" id="navMore"><span class="mono">Straight to</span></div>
  </div>
</nav>
<ol class="rail" id="rail" aria-label="Chapters"></ol>
<div class="bar" aria-hidden="true"><i id="bar"></i></div>
<div class="col" id="col"><span>Stubs</span><i data-c="13">13</i><i data-c="29">29</i><i data-c="45">45</i><i data-c="54">54</i><i data-c="58">58</i><i data-c="61">61</i><i data-c="63">63</i></div>
<Sticker type="rnd" a="01" b="CHAPTER" class="y chap" id="chapSt" />

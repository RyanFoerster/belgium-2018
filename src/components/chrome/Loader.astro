---
/* The loader is the press: a poster screen-printed in three passes (yellow, red, black) while the page arrives.
   Each layer is clipped by --q1/--q2/--q3, set by scripts/loader.js; the sheet is then pulled off, a yellow and a red one behind it. */
import Poster from '../ui/Poster.astro';
---
<div class="ld" id="ld" aria-hidden="true" data-pass="1">
  <i class="ld-c ld-c3" data-torn="b" data-torn-d="24"></i>
  <i class="ld-c ld-c2" data-torn="b" data-torn-d="24"></i>
  <div class="ld-p" data-torn="b" data-torn-d="24">
    <div class="ld-top"><span>BEL—18 · The Road to Glory</span><span>Three-colour print · Yellow / Red / Black</span></div>
    <div class="ld-art" id="ldArt">
      <Poster />
    </div>
    <div class="ld-ui"><div class="ld-bar"><i class="by"><b></b></i><i class="br"><b></b></i><i class="bk"><b></b></i></div><span class="ld-pass" id="ldPass">Pass 1/3 — Yellow</span><b class="ld-n" id="ldN">000</b></div>
  </div>
</div>
